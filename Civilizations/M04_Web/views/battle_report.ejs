<%- include('partials/head', { title: 'Informe Batalla ' + battle.num }) %>
<%- include('partials/header') %>

<main>
    <h1>Informe de Batalla #<%= battle.num %></h1>
    <p style="text-align:center;">Madera obtenida: <%= battle.wood %> | Hierro obtenido: <%= battle.iron %></p>

    <div style="display:flex; flex-wrap:wrap; gap:2rem;">
        <!-- Unidades civilización -->
        <div style="flex:1; min-width:250px;">
            <h3>Ataque Civilización</h3>
            <table>
                <thead><tr><th>Tipo</th><th>Inicial</th><th>Bajas</th></tr></thead>
                <tbody>
                    <% civAttack.forEach(u => { %>
                        <tr><td><%= u.type %></td><td><%= u.initial %></td><td><%= u.drops %></td></tr>
                    <% }) %>
                </tbody>
            </table>

            <h3>Defensa Civilización</h3>
            <table>
                <thead><tr><th>Tipo</th><th>Inicial</th><th>Bajas</th></tr></thead>
                <tbody>
                    <% civDefense.forEach(u => { %>
                        <tr><td><%= u.type %></td><td><%= u.initial %></td><td><%= u.drops %></td></tr>
                    <% }) %>
                </tbody>
            </table>

            <h3>Especiales Civilización</h3>
            <table>
                <thead><tr><th>Tipo</th><th>Inicial</th><th>Bajas</th></tr></thead>
                <tbody>
                    <% civSpecial.forEach(u => { %>
                        <tr><td><%= u.type %></td><td><%= u.initial %></td><td><%= u.drops %></td></tr>
                    <% }) %>
                </tbody>
            </table>
        </div>

        <!-- Enemigo -->
        <div style="flex:1; min-width:250px;">
            <h3>Ejército Enemigo</h3>
            <table>
                <thead><tr><th>Tipo</th><th>Inicial</th><th>Bajas</th></tr></thead>
                <tbody>
                    <% enemy.forEach(u => { %>
                        <tr><td><%= u.type %></td><td><%= u.initial %></td><td><%= u.drops %></td></tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Desarrollo de la batalla -->
    <h2 style="margin-top:2rem;">Desarrollo de la batalla</h2>
    <div style="background:#000; color:#0f0; padding:1rem; border:2px solid var(--color-oro); max-height:300px; overflow-y:auto; font-family: monospace;">
        <% log.forEach(line => { %>
            <%= line.entry %><br>
        <% }) %>
    </div>
</main>

<%- include('partials/footer') %>