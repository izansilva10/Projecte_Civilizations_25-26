<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Informe de Batalla - Civilizations</title>
  <link rel="icon" href="/portfolio.ico">
  <link rel="stylesheet" href="/css/styles.css" />
  <link rel="icon" type="image/x-icon" href="/img/ico/favicon.ico" />
</head>
<body>
  
  {{> header}}

  <main class="container">
    <H1>INFORMES</H1>
    
    <section class="card">
      <div class="card-header">
        <h2>Informe de Batalla #{{batalla.num_battle}}</h2>
        <a href="/batalles" class="btn-table">Volver al listado</a>
      </div>

      {{#if batalla}}
      <div style="margin-top: 20px; line-height: 1.8;">
        <p><strong>Atacante:</strong> Civilización</p>
        <p><strong>Defensor:</strong> Enemigo</p>
        <p><strong>Resultado:</strong> 
          <span class="badge {{#if (eq resultado 'Victoria')}}victory{{else}}defeat{{/if}}">
            {{resultado}}
          </span>
        </p>
        <p><strong>Madera obtenida:</strong> {{batalla.wood_acquired}}</p>
        <p><strong>Hierro obtenido:</strong> {{batalla.iron_acquired}}</p>
        
        <hr style="border: 0; border-top: 1px solid rgba(255,255,255,0.08); margin: 20px 0;">
        
        <h3>Desarrollo de la Batalla</h3>
        <div style="background: rgba(0,0,0,0.3); padding: 15px; border-radius: 8px; font-family: monospace; color: #a9ffeb; white-space: pre-wrap;">
          {{{desarrollo}}}
        </div>

        <h3 style="margin-top: 20px;">Estadísticas de Unidades</h3>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
          <div>
            <h4>Civilización (Ataque)</h4>
            <ul>
              {{#each ataque}}
              <li>{{type}}: Inicial {{initial}}, Bajas {{drops}}</li>
              {{else}}
              <li>Sin datos de ataque</li>
              {{/each}}
            </ul>
            <h4>Civilización (Defensa)</h4>
            <ul>
              {{#each defensa}}
              <li>{{type}}: Inicial {{initial}}, Bajas {{drops}}</li>
              {{else}}
              <li>Sin datos de defensa</li>
              {{/each}}
            </ul>
            <h4>Civilización (Especiales)</h4>
            <ul>
              {{#each especiales}}
              <li>{{type}}: Inicial {{initial}}, Bajas {{drops}}</li>
              {{else}}
              <li>Sin unidades especiales</li>
              {{/each}}
            </ul>
          </div>
          <div>
            <h4>Enemigo</h4>
            <ul>
              {{#each enemigo}}
              <li>{{type}}: Inicial {{initial}}, Bajas {{drops}}</li>
              {{else}}
              <li>Sin datos del enemigo</li>
              {{/each}}
            </ul>
          </div>
        </div>
      </div>
      {{else}}
      <p class="muted">No se encontraron datos para esta batalla.</p>
      {{/if}}
    </section>

  </main>

  {{> footer}}

</body>
</html>