<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Historial de Batallas - Civilizations</title>
  <link rel="icon" type="image/x-icon" href="/img/ico/favicon.ico" />
  <link rel="stylesheet" href="/css/styles.css" />
</head>
<body>
  
  {{> header}}

  <main class="container">
    <H1>BATALLAS</H1>
    
    <section class="card">
      <div class="card-header">
        <h2>Registro Histórico de Batallas</h2>
        <span class="muted">Mostrando todos los enfrentamientos registrados</span>
      </div>

      <div class="table-container" style="margin-top: 20px;">
        <table class="battles-table">
          <thead>
            <tr>
              <th>ID</th>
              <th>Atacante</th>
              <th>Defensor</th>
              <th>Resultado</th>
              <th>Acción</th>
            </tr>
          </thead>
          <tbody>
            {{#each batallas}}
            <tr>
              <td>#{{this.id}}</td>
              <td>{{this.atacante}}</td>
              <td>{{this.defensor}}</td>
              <td>
                <span class="badge {{#if (eq this.resultado 'victoria')}}victory{{else}}defeat{{/if}}">
                  {{#if (eq this.resultado 'victoria')}}Victoria{{else}}Derrota{{/if}}
                </span>
              </td>
              <td><a href="/informes?informe={{this.id}}" class="btn-table">Detalles</a></td>
            </tr>
            {{else}}
            <tr>
              <td colspan="5">No hay batallas registradas.</td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    </section>

  </main>

  {{> footer}}

</body>
</html>