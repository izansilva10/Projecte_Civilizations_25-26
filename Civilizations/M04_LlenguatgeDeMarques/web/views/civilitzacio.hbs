<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Civilización - Civilizations</title>
  <link rel="icon" type="image/x-icon" href="/img/ico/favicon.ico" />
  <link rel="stylesheet" href="/css/styles.css" />
</head>
<body>
  
  {{> header}}

  <main class="container">
    <H1>CIVILIZACIÓN</H1>
    
    <section class="card">
      <div class="card-header">
        <h2>Recursos Disponibles</h2>
        <span class="muted">Actualizado en tiempo real</span>
      </div>
      
      {{#if civ}}
      <ul class="projects" style="grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));">
        <li class="project">
          <div class="project-link" style="transform: none; cursor: default;">
            <div class="project-info">
              <span class="project-title">🌾 Comida</span>
              <span class="project-desc">Necesaria para alimentar tropas</span>
            </div>
            <span class="box-link" style="background: rgba(0, 255, 213, 0.1); border-color: #00ffd5; color: #00ffd5;">{{civ.food_amount}}</span>
          </div>
        </li>
        <li class="project">
          <div class="project-link" style="transform: none; cursor: default;">
            <div class="project-info">
              <span class="project-title">🪵 Madera</span>
              <span class="project-desc">Construcción de edificios y armas</span>
            </div>
            <span class="box-link" style="background: rgba(0, 255, 213, 0.1); border-color: #00ffd5; color: #00ffd5;">{{civ.wood_amount}}</span>
          </div>
        </li>
        <li class="project">
          <div class="project-link" style="transform: none; cursor: default;">
            <div class="project-info">
              <span class="project-title">🪙 Hierro</span>
              <span class="project-desc">Forja de armaduras y armamento</span>
            </div>
            <span class="box-link" style="background: rgba(0, 255, 213, 0.1); border-color: #00ffd5; color: #00ffd5;">{{civ.iron_amount}}</span>
          </div>
        </li>
        <li class="project">
          <div class="project-link" style="transform: none; cursor: default;">
            <div class="project-info">
              <span class="project-title">🔮 Maná</span>
              <span class="project-desc">Energía para hechizos y magia</span>
            </div>
            <span class="box-link" style="background: rgba(0, 255, 213, 0.1); border-color: #00ffd5; color: #00ffd5;">{{civ.mana_amount}}</span>
          </div>
        </li>
      </ul>

      <div style="margin-top: 20px; display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
        <div>
          <h3>Edificios</h3>
          <p><strong>Granjas:</strong> {{civ.farm_counter}}</p>
          <p><strong>Carpinterías:</strong> {{civ.carpentry_counter}}</p>
          <p><strong>Herrerías:</strong> {{civ.smithy_counter}}</p>
          <p><strong>Torres Mágicas:</strong> {{civ.magicTower_counter}}</p>
          <p><strong>Iglesias:</strong> {{civ.church_counter}}</p>
        </div>
        <div>
          <h3>Tecnología</h3>
          <p><strong>Defensa:</strong> Nivel {{civ.technology_defense_level}}</p>
          <p><strong>Ataque:</strong> Nivel {{civ.technology_attack_level}}</p>
        </div>
      </div>
      {{else}}
      <p class="muted">No se encontraron datos de la civilización.</p>
      {{/if}}
    </section>

  </main>

  {{> footer}}

</body>
</html>